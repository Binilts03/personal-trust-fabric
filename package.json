{
  "name": "personal-trust-fabric",
  "version": "0.1.0",
  "description": "User-owned trust and delegated-authority layer for the agentic web (PTF v0.1)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "ptf": "./dist/src/cli.js",
    "ptf-mcp-server": "./dist/src/mcp-server.js"
  },
  "keywords": [
    "trust",
    "delegation",
    "capabilities",
    "authorization",
    "agents",
    "x402",
    "ap2"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Binilts03/personal-trust-fabric.git"
  },
  "homepage": "https://github.com/Binilts03/personal-trust-fabric#readme",
  "bugs": {
    "url": "https://github.com/Binilts03/personal-trust-fabric/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "eval": "npm run build && node --test \"dist/tests/eval/*.test.js\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run eval",
    "dev-local": "bash scripts/dev-local.sh up",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.2"
  }
}
