source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "just-the-docs", "~> 0.8"
gem "jekyll-include-cache", "~> 0.2"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-seo-tag", "~> 2.8"
gem "webrick", "~> 1.8"

# Pin jekyll-sass-converter to v2 — v3 resolves imports from the current file's
# directory, which breaks the theme's internal SCSS entry points that use
# relative imports expecting _sass/ as the root.
gem "jekyll-sass-converter", "~> 2.0"
